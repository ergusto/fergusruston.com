{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fergusruston-com",
  "compatibility_date": "2026-10-01",
  // The worker only exists to redirect the bare domain to www; everything else is static files
  "main": "worker.js",
  "routes": [
    { "pattern": "www.fergusruston.com", "custom_domain": true },
    { "pattern": "fergusruston.com", "custom_domain": true }
  ],
  // Wrangler switches the workers.dev address off once a custom domain is set, unless told otherwise
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
